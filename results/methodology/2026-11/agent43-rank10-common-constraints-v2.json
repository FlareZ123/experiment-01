    "positiveMaxAllowedDamageIsNotAssumedToBeAHardCap": true
  },
  "informationBoundary": "actor-visible observation and public prompt choices only",
  "policyRandomization": "none",
  "seedAsPolicyInput": false,
  "runnerFork": false,
  "validatorFork": false,
  "firstTraceIntegration": false,
  "candidateDeckMutation": false,
  "gamesOrFixturesRun": false,
  "status": "provisional research constraint set; not bound to signed V3 policy-plan core"
}
