+// Rank19-only proposed energy prompt contracts. The host separately authenticates
+// the exact opponent fingerprint and pinned native source before projection.
+function rank19EnergySource(prompt) {
+  const s=prompt.source, t=prompt.publicMetadata.selectionType;
+  if(s.sourceKind!=='card-effect'||s.copiedSourcePrinting!==undefined||s.copiedAttackName!==undefined)return null;
+  if(t==='energy-discard'&&s.effectName==='Bellowing Thunder'&&/^Raging Bolt ex TEF(?: 123)?$/.test(s.sourcePrinting))return {zone:'play',min:0,max:null};
+  if(t!=='energy-attachment-set')return null;
+  if(s.effectName==="Professor Sada's Vitality"&&/^Professor Sada's Vitality PAR(?: 170)?$/.test(s.sourcePrinting))return {zone:'discard',min:1,max:2,distinct:true};
+  if(s.effectName==='Ultimate Ray'&&/^Arceus & Dialga & Palkia-? ?GX CEC(?: 156)?$/.test(s.sourcePrinting))return {zone:'deck',min:0,max:3};
+  if(s.effectName==='Magnetic Absorption'&&/^Sandy Shocks ex PAR(?: 108)?$/.test(s.sourcePrinting))return {zone:'discard',min:1,max:1};
+  if(s.effectName==='Dance of the Ancients'&&/^Tapu Koko (?:Prism Star|◇|♢) TEU(?: 51)?$/.test(s.sourcePrinting))return {zone:'discard',min:2,max:2,distinct:true};
+  if(s.effectName==='Raihan'&&/^Raihan EVS(?: 152)?$/.test(s.sourcePrinting))return {zone:'discard',min:1,max:1};
+  return null;
+}
+function validateRank19EnergyPrompt(prompt) {
+  const m=prompt.publicMetadata, t=m.selectionType;
+  if(!['energy-discard','energy-attachment-set'].includes(t))return;
+  const s=rank19EnergySource(prompt);
+  if(!s||m.allowCancel!==false||m.minimumCount!==s.min||(s.max!==null&&m.maximumCount!==s.max))fail('BAD_RANK19_ENERGY_SOURCE');
+  const items=prompt.choices.filter(c=>c.kind==='energy'),seen=new Set();
+  if(t==='energy-discard'&&m.maximumCount!==items.length)fail('BAD_RANK19_ENERGY_BOUNDS');
+  for(const c of items){
+    const z=c.publicMetadata;
+    if(!z||z.ownerSeat!=='actor'||z.sourceZone!==s.zone||z.isOwnerVisible!==true||z.energyType!=='BASIC'||z.selectedCount!==1||!['active','bench'].includes(z.zone)||(z.zone==='bench'&&!Number.isSafeInteger(z.benchIndex)))fail('BAD_RANK19_ENERGY_ITEM');
+    const id=t==='energy-discard'?z.slotIndex:z.selectionIndex;
+    if(!Number.isSafeInteger(id))fail('BAD_RANK19_ENERGY_ITEM');
+    const k=z.zone+':'+(z.benchIndex??0)+':'+id;
+    if(seen.has(k))fail('DUPLICATE_RANK19_ENERGY_ITEM');seen.add(k);
+  }
